{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATK Tray Monitor",
  "version": "0.1.0",
  "identifier": "com.atk.traymonitor",
  "build": {
    "beforeDevCommand": "npm run start -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/atk-tray-monitor/browser",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATK Tray Monitor",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}